local.file_match "backend" {
  path_targets = [
    {
      __path__ = "/var/log/mlsre/app.log",
      job      = "backend",
      service  = "mlsre",
    },
  ]
}

loki.source.file "backend" {
  targets    = local.file_match.backend.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
