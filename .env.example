POSTGRES_DB=mlsre
POSTGRES_PASSWORD=change-me
APP_DB_USER=mlsre_app
APP_DB_PASSWORD=change-me
MIGRATION_DB_USER=mlsre_migrate
MIGRATION_DB_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://mlsre_app:change-me@db:5432/mlsre
MIGRATION_DATABASE_URL=postgresql+psycopg://mlsre_migrate:change-me@db:5432/mlsre
JWT_SECRET=replace-with-a-long-random-secret-32b
# Puertos publicados en el host. Si el default está ocupado, usá el secundario
# (FRONTEND 3100, BACKEND 8010, GRAFANA 3011, POSTGRES 5434) y alineá CORS y API:
FRONTEND_PORT=3000
BACKEND_PORT=8000
GRAFANA_PORT=3001
POSTGRES_HOST_PORT=5433
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
PRODUCT_IMAGES_DIR=var/product-images
PROFILE_IMAGES_DIR=var/profile-images
LOG_FILE=var/logs/app.log
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
DEMO_PASSWORD=mlsre-demo

# Sin Docker (./scripts/up-local.sh). No pisa este archivo: el script
# exporta sqlite a backend/var/mlsre.db salvo USE_POSTGRES=1.
# DATABASE_URL=sqlite:///./var/mlsre.db
# MIGRATION_DATABASE_URL=sqlite:///./var/mlsre.db
# En host/HR: NEXT_PUBLIC_API_URL=/backend y REFRESH_COOKIE_PATH=/backend/auth
# (el script los pone solo; Compose sigue con localhost:8000 y Path=/auth).
